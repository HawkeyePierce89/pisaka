.build/
.swiftpm/
.DS_Store

# Build artifacts from running the CI build commands locally: the workflow uses
# relative `-clonedSourcePackagesDirPath SourcePackages` / `-derivedDataPath
# DerivedData`, so a local repro drops these in the repo root.
SourcePackages/
DerivedData/

# The release archive path, used verbatim by `.github/workflows/release.yml`,
# `docs/RELEASING.md` and the archive command in `CLAUDE.md`
# (`-archivePath build/Pisaka-macOS.xcarchive`), plus the zip staging directory
# beside it. A local release repro must leave `git status` clean: the build
# number is passed on the command line and never committed, so the archive it
# produces must not be the thing that dirties the tree instead.
build/

# The Xcode project is generated by XcodeGen from `project.yml` — do not commit
# the project itself. But DO commit the resolved Swift Package pins it produces,
# so transitive dependency versions (e.g. tree-sitter, swift-argument-parser)
# stay locked for reproducible builds — the role the root `Package.resolved`
# played before the app target moved into the Xcode project. (Git can only
# re-include a file when no parent directory is excluded, so each level is
# excluded with `/*` and the next path component re-included in turn — which is
# why the whole `Pisaka.xcodeproj` directory is not excluded outright.)
Pisaka.xcodeproj/*
!Pisaka.xcodeproj/project.xcworkspace
Pisaka.xcodeproj/project.xcworkspace/*
!Pisaka.xcodeproj/project.xcworkspace/xcshareddata
Pisaka.xcodeproj/project.xcworkspace/xcshareddata/*
!Pisaka.xcodeproj/project.xcworkspace/xcshareddata/swiftpm
Pisaka.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!Pisaka.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
